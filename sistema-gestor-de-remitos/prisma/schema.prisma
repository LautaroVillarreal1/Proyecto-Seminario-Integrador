generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  idUsuario         Int      @id @default(autoincrement()) // tipo asumido
  nombre            String
  apellido          String
  correoElectronico String   @unique
  passwordHash      String
  activo            Boolean  @default(true)
  idRol             Int
  rol               Rol      @relation(fields: [idRol], references: [idRol])
  remitos           Remito[]
}

model Rol {
  idRol    Int       @id @default(autoincrement()) // tipo asumido
  nombre   String
  // Valores indicados en el DER: Admin, EP (Encargado de Producción), RE (Responsable de entrega)
  usuarios Usuario[]
}

model Cliente {
  idCliente         Int       @id @default(autoincrement()) // tipo asumido
  nombre            String
  descripcion       String?   @db.VarChar(400)
  direccion         String // "direccion(calle numero)" en el DER
  correoElectronico String
  numeroDeTelefono  String
  latitud           Float?
  longitud          Float?
  idProvincia       Int
  provincia         Provincia @relation(fields: [idProvincia], references: [idProvincia])
  remitos           Remito[]
}

model Provincia {
  idProvincia Int       @id @default(autoincrement()) // tipo asumido
  nombre      String
  descripcion String
  idCiudad    Int?
  ciudad      Ciudad?   @relation("ProvinciaToCiudad", fields: [idCiudad], references: [idCiudad])
  ciudades    Ciudad[]  @relation("CiudadToProvincia")
  clientes    Cliente[]
}

model Ciudad {
  idCiudad     Int         @id @default(autoincrement()) // tipo asumido
  nombre       String
  descripcion  String
  codigoPostal String
  idProvincia  Int
  provincia    Provincia   @relation("CiudadToProvincia", fields: [idProvincia], references: [idProvincia])
  provincias   Provincia[] @relation("ProvinciaToCiudad")
  // Nota: el DER muestra FK en ambos sentidos (Provincia->Ciudad y Ciudad->Provincia),
  // se transcribieron ambas relaciones tal cual figuran.
}

model Estado {
  idEstado    Int      @id @default(autoincrement()) // tipo asumido
  nombre      String
  descripcion String
  // Valores indicados en el DER: Aceptado, EnPreparación, Anulado, ListoParaEntrega, Firmado, Cobrado, Rechazado
  remitos     Remito[]
}

model Categoria {
  idCategoria Int        @id @default(autoincrement()) // tipo asumido
  nombre      String
  // Valores indicados en el DER: Yogur, Mermelada, Kefir, Dulce solido, Postre, Dulce de Leche
  productos   Producto[]
}

model UnidadDeMedida {
  idUnidadDeMedida Int        @id @default(autoincrement()) // tipo asumido
  nombre           String
  productos        Producto[]
  insumos          Insumo[]
}

model Receta {
  idReceta          Int             @id @default(autoincrement())
  descripcion       String
  rendimiento       Float           @default(1)
  unidadRendimiento String          @default("unidad")
  tiempoPrepMin     Int             @default(0)
  instrucciones     String?
  productos         Producto[]
  detalles          DetalleReceta[]
}

model DetalleReceta {
  idDetalleReceta Int    @id @default(autoincrement())
  cantidad        Float
  idReceta        Int
  receta          Receta @relation(fields: [idReceta], references: [idReceta], onDelete: Cascade)
  idInsumo        Int
  insumo          Insumo @relation(fields: [idInsumo], references: [idInsumo])
}

model Insumo {
  idInsumo         Int             @id @default(autoincrement()) // tipo asumido
  nombre           String
  descripcion      String
  stockActual      Float           @default(0)
  stockMinimo      Float           @default(0)
  costoUnitario    Decimal         @default(0)
  proveedor        String?
  idUnidadDeMedida Int
  unidadDeMedida   UnidadDeMedida  @relation(fields: [idUnidadDeMedida], references: [idUnidadDeMedida])
  detalleRecetas   DetalleReceta[]
}

model Producto {
  idProducto       Int             @id @default(autoincrement()) // tipo asumido
  codigo           String          @unique
  codigoBarras     String?         @unique
  nombre           String
  precioUnitario   Decimal // tipo asumido
  descripcion      String
  peso             Float // tipo asumido
  stockActual      Float           @default(0)
  stockMinimo      Float           @default(0)
  activo           Boolean         @default(true)
  idUnidadDeMedida Int
  unidadDeMedida   UnidadDeMedida  @relation(fields: [idUnidadDeMedida], references: [idUnidadDeMedida])
  idreceta         Int?
  receta           Receta?         @relation(fields: [idreceta], references: [idReceta])
  idCategoria      Int
  categoria        Categoria       @relation(fields: [idCategoria], references: [idCategoria])
  detalleRemitos   DetalleRemito[]
}

model DetalleRemito {
  idDetalleRemito Int      @id @default(autoincrement())
  subTotal        Decimal
  cantidad        Int      @default(1)
  idProducto      Int
  producto        Producto @relation(fields: [idProducto], references: [idProducto])
  idRemito        Int
  remito          Remito   @relation(fields: [idRemito], references: [idRemito], onDelete: Cascade)
}

model Remito {
  idRemito         Int             @id @default(autoincrement())
  fechaEntrega     DateTime // tipo asumido
  horaEntrega      DateTime // tipo asumido
  idUsuario        Int
  usuario          Usuario         @relation(fields: [idUsuario], references: [idUsuario])
  idEstado         Int
  estado           Estado          @relation(fields: [idEstado], references: [idEstado])
  idCliente        Int
  cliente          Cliente         @relation(fields: [idCliente], references: [idCliente])
  observacion      String?
  inconveniente    String?
  formaPago        String?
  fechaEntregaReal DateTime?
  detalles         DetalleRemito[]
}
